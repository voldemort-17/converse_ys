generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                 String          @id @map("_id")
  username           String          @unique
  avatar             String?
  cover              String?
  description        String?
  name               String?
  surname            String?
  city               String?
  school             String?
  work               String?
  website            String?
  createdAt          DateTime        @default(now())
  posts              Post[]
  likes              Like[]
  comments           Comment[]
  followingRelations Follower[]      @relation("Follower")
  followerRelations  Follower[]      @relation("Following")
  followReqSent      FollowRequest[] @relation("FollowReqSent")
  followReqRecieved  FollowRequest[] @relation("FollowReqRecieved")
  blockRecieved      Block[]         @relation("BlockRecieved")
  blockSent          Block[]         @relation("BlockSent")
  stories            Story[]
  notifications      Notifications[]
}

model Post {
  id            String          @id @default(cuid()) @map("_id")
  desc          String
  image         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id])
  userId        String
  likes         Like[]
  comments      Comment[]
  notifications Notifications[]

  @@index([userId, createdAt])
}

model Story {
  id        String   @id @default(cuid()) @map("_id")
  createdAt DateTime @default(now())
  img       String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique

  @@index([expiresAt])
}

model Comment {
  id        String   @id @default(cuid()) @map("_id")
  desc      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  post      Post     @relation(fields: [postId], references: [id])
  postId    String
  likes     Like[]

  @@index([postId, createdAt])
}

model Like {
  id        String   @id @default(cuid()) @map("_id")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  post      Post?    @relation(fields: [postId], references: [id])
  postId    String?
  comment   Comment? @relation(fields: [commentId], references: [id])
  commentId String?

  @@unique([userId, postId, commentId])
  @@index([postId])
  @@index([commentId])
}

model Follower {
  id          String   @id @default(cuid()) @map("_id")
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id])
  followerId  String
  following   User     @relation("Following", fields: [followingId], references: [id])
  followingId String

  @@unique([followerId, followingId])
  @@index([followingId])
}

model FollowRequest {
  id         String   @id @default(cuid()) @map("_id")
  createdAt  DateTime @default(now())
  sender     User     @relation("FollowReqSent", fields: [senderId], references: [id])
  senderId   String
  reciever   User     @relation("FollowReqRecieved", fields: [recieverId], references: [id])
  recieverId String

  @@unique([senderId, recieverId])
  @@index([recieverId, createdAt])
}

model Block {
  id        String   @id @default(cuid()) @map("_id")
  createdAt DateTime @default(now())
  blocker   User     @relation("BlockSent", fields: [blockerId], references: [id])
  blockerId String
  blocked   User     @relation("BlockRecieved", fields: [blockedId], references: [id])
  blockedId String

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Notifications {
  id        String   @id @default(cuid()) @map("_id")
  createdAt DateTime @default(now())
  expiresAt DateTime
  desc      String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  post      Post     @relation(fields: [postId], references: [id])
  postId    String
  isRead    Boolean  @default(false)

  @@index([userId, isRead, expiresAt])
}
