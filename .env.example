# MongoDB connection used by Prisma
DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/converse"
# Optional custom CA path for corporate TLS inspection
# MONGODB_TLS_CA_FILE="C:/path/to/company-ca-chain.pem"

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Cloudinary uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
